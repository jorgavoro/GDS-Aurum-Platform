<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- ====================================================== -->
    <!-- Parent                                                  -->
    <!-- ====================================================== -->

    <parent>
        <groupId>com.globaldynamicssystems</groupId>
        <artifactId>gds-aurum-ai</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <!-- ====================================================== -->
    <!-- Project                                                 -->
    <!-- ====================================================== -->

    <artifactId>aurum-bootstrap</artifactId>
    <packaging>jar</packaging>

    <name>Aurum Bootstrap</name>

    <description>
        Bootstrap module responsible for starting
        the GDS Aurum AI Platform.
    </description>

    <!-- ====================================================== -->
    <!-- Dependencies                                            -->
    <!-- ====================================================== -->

    <dependencies>

        <!-- ================================================== -->
        <!-- Spring Boot                                        -->
        <!-- ================================================== -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- ================================================== -->
        <!-- OpenAPI                                            -->
        <!-- ================================================== -->

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <!-- ================================================== -->
        <!-- Lombok                                             -->
        <!-- ================================================== -->

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ================================================== -->
        <!-- Internal Modules                                   -->
        <!-- ================================================== -->

        <dependency>
            <groupId>com.globaldynamicssystems</groupId>
            <artifactId>aurum-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.globaldynamicssystems</groupId>
            <artifactId>aurum-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.globaldynamicssystems</groupId>
            <artifactId>aurum-framework</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.globaldynamicssystems</groupId>
            <artifactId>aurum-engine</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.globaldynamicssystems</groupId>
            <artifactId>aurum-metadata</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.globaldynamicssystems</groupId>
            <artifactId>aurum-api</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.globaldynamicssystems</groupId>
            <artifactId>aurum-security</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ================================================== -->
        <!-- Test                                               -->
        <!-- ================================================== -->

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <!-- ====================================================== -->
    <!-- Build                                                   -->
    <!-- ====================================================== -->

    <build>

        <plugins>

            <plugin>

                <groupId>org.springframework.boot</groupId>

                <artifactId>spring-boot-maven-plugin</artifactId>

                <configuration>

                    <mainClass>
                        com.globaldynamicssystems.aurum.bootstrap.AurumBootstrapApplication
                    </mainClass>

                </configuration>

            </plugin>

        </plugins>

    </build>

</project>